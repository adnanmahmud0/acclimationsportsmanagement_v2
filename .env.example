# Environment Setup
NODE_ENV=development

# Database Configuration (MongoDB)
# Replace with your actual MongoDB connection string
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/acclimation

# Security & Authentication
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE_IN=1d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRE_IN=365d

# Email Configuration (for password resets, notifications, etc.)
EMAIL_FROM=noreply@yourdomain.com
EMAIL_USER=your_email@gmail.com
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PASS=your_app_password_here

# Initial Super Admin Credentials (used to seed the first admin account)
SUPER_ADMIN_EMAIL=admin@admin.com
SUPER_ADMIN_PASSWORD=Admin123!

# Storage Configuration (for uploading images via CMS)
IMAGEBB_API_KEY=your_imagebb_api_key_here
